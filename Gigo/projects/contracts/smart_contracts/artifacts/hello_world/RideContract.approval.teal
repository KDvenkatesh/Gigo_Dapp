// algopy.arc4.ARC4Contract.approval_program() -> uint64:
main:
    intcblock 0 1 4 8 29000
    bytecblock "gigo_asset_id" "c_" "f_"
    txn ApplicationID
    bnz main_after_if_else@2
    // smart_contracts/hello_world/contract.py:21
    // self.gigo_asset_id = GlobalState(UInt64(763011769))
    bytec_0 // "gigo_asset_id"
    pushint 763011769
    app_global_put

main_after_if_else@2:
    // smart_contracts/hello_world/contract.py:15
    // class RideContract(ARC4Contract):
    txn NumAppArgs
    bz main___algopy_default_create@13
    txn OnCompletion
    !
    assert
    txn ApplicationID
    assert
    pushbytess 0x53a7690d 0x6bde30f8 0x521a12c2 0x97d3bc18 // method "opt_in_to_asa()void", method "init_escrow(axfer,uint64)void", method "payout(uint64,address)void", method "cancel_and_refund(uint64)void"
    txna ApplicationArgs 0
    match opt_in_to_asa init_escrow payout cancel_and_refund
    err

main___algopy_default_create@13:
    txn OnCompletion
    !
    txn ApplicationID
    !
    &&
    return


