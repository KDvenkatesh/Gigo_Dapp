    // smart_contracts/hello_world/contract.py:41
    // rid = ride_id.native
    btoi
    // smart_contracts/hello_world/contract.py:42
    // assert not self.escrow_customer.maybe(rid)[1], "ride_id already exists"
    itob
    bytec_1 // "c_"
    dig 1
    concat
    dup
    box_len
    bury 1
    !
    assert // ride_id already exists
    // smart_contracts/hello_world/contract.py:44-45
