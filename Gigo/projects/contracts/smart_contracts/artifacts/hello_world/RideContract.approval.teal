    ==
    assert // wrong asset
    // smart_contracts/hello_world/contract.py:47
    // assert pay_txn.asset_amount > UInt64(0), "amount must be > 0"
    dig 2
    gtxns AssetAmount
    dup
    assert // amount must be > 0
    // smart_contracts/hello_world/contract.py:49-50
    // # Record escrow details
    // self.escrow_customer[rid] = pay_txn.sender
    uncover 3
    gtxns Sender
    uncover 2
    swap
    box_put
    // smart_contracts/hello_world/contract.py:51
    // self.escrow_fare[rid] = pay_txn.asset_amount
    bytec_2 // "f_"
    uncover 2
    concat
    swap
    itob
    box_put
    // smart_contracts/hello_world/contract.py:35
    // @arc4.abimethod
    intc_1 // 1
    return


